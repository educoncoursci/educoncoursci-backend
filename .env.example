# ============================================================
#  Variables d'environnement — EduConcoursCI (backend)
#  Copie ce fichier en ".env" et remplis les vraies valeurs.
#  Ne jamais committer le fichier ".env" (déjà exclu par .gitignore).
# ============================================================

# ── 🔴 INDISPENSABLE — le site ne démarre pas sans ça ──────────

# Fournie automatiquement par Railway/Render dès que tu ajoutes
# une base PostgreSQL au projet — copie-colle leur valeur telle quelle.
DATABASE_URL=postgresql://user:password@host:5432/nom_de_la_base

# Clé secrète pour signer les sessions de connexion. Génère la tienne
# avec : node scripts/generer-jwt-secret.js — ne réutilise jamais un
# exemple trouvé en ligne, ni cette valeur telle quelle.
JWT_SECRET=remplace_moi_avec_le_script

JWT_EXPIRES_IN=7d
NODE_ENV=production
PORT=3000

# URL publique de ton frontend une fois déployé (Netlify te la donne).
# Sert à autoriser les appels API depuis ton site (CORS) et dans les
# liens envoyés par email.
FRONTEND_URL=https://ton-site.netlify.app

# Identifiants du tout premier compte admin, créés par
# scripts/init-admin.js — change le mot de passe après la 1ère connexion.
ADMIN_EMAIL=akone97@hotmail.com
ADMIN_PASSWORD=change_moi_immediatement


# ── 🟠 IMPORTANT — nécessaire pour générer des revenus ──────────

# Compte marchand CinetPay (paiement carte + mobile money automatique).
# Sans ces deux clés, le site reste utilisable : les paiements
# passent alors en mode manuel (Wave/Orange/MTN/Moov avec validation
# admin d'un ID de transaction) — plus lent mais fonctionnel pour
# démarrer sans attendre l'ouverture du compte CinetPay.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=https://ton-backend.up.railway.app/api/payment/cinetpay/webhook
CINETPAY_RETURN_URL=https://ton-site.netlify.app/dashboard/paiements.html

# Numéros affichés pour le paiement manuel (mode de secours toujours actif)
WAVE_NUMERO=
WAVE_LIEN_PAIEMENT=
OM_NUMERO=
MTN_NUMERO=
MOOV_NUMERO=

# Envoi d'emails transactionnels (bienvenue, confirmation de paiement,
# reset mot de passe...). Un compte Gmail avec mot de passe d'application
# fonctionne pour démarrer ; un service dédié (Brevo, Mailgun...) est
# recommandé une fois le volume plus important.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="EduConcoursCI <contact@educoncoursci.ci>"


# ── 🟡 OPTIONNEL — améliore l'expérience, pas bloquant ──────────

# Assistant IA (aide à la préparation, résumés...). Sans cette clé,
# les fonctionnalités liées à l'IA sont simplement indisponibles.
ANTHROPIC_API_KEY=

# Détection automatique de nouveaux concours (scraper). Sans ces clés,
# seule la surveillance par flux RSS fonctionne, pas la recherche
# Google — la détection reste active mais moins large.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_REQUETES=concours fonction publique côte d'ivoire,concours ENA côte d'ivoire

# Flux RSS surveillés pour la détection automatique (actualités/emplois),
# séparés par des virgules. Optionnel au lancement.
ACTUALITES_FLUX_URLS=
EMPLOI_FLUX_URLS=

# Notifications push navigateur. Génère les tiennes avec :
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS (rappels de clôture...). Optionnel — les emails suffisent au lancement.
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=EduConcoursCI

# WhatsApp Business API. Optionnel.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Limites techniques (valeurs par défaut déjà raisonnables, à ajuster
# seulement si besoin)
MAX_FILE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=200
MAX_PHOTO_SIZE_MB=5
QUOTA_IA_GRATUIT_JOUR=3
